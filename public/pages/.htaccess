# Rameva 2 — внутренний каталог: прямой веб-доступ закрыт.
#
# pages/ содержит исходные шаблоны страниц (с {{ плейсхолдерами }}), которые
# при прямом запросе отдаются веб-сервером как статические файлы. Это дубли
# контента и раскрытие шаблонов, поэтому каталог закрывается.
#
# Это лишь один слой защиты: на Nginx .htaccess не действует, аналогичные
# ограничения приведены в deploy/nginx/ (справочный материал).
<IfModule authz_core_module>
	Require all denied
</IfModule>
<IfModule !authz_core_module>
	Deny from all
</IfModule>
