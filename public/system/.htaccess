# Rameva 2 — внутренний каталог ядра: прямой веб-доступ закрыт.
#
# system/ — код ядра и сервисов фреймворка. Классы защищены PHP Guard
# (403 при прямом обращении), но сам каталог веб-серверу отдавать незачем.
#
# Это лишь один слой защиты: на Nginx .htaccess не действует, аналогичные
# ограничения приведены в deploy/nginx/ (справочный материал).
#
# Внимание: этот файл входит в манифест целостности (Tripwire), так как
# расположен внутри отслеживаемого каталога system/.
<IfModule authz_core_module>
	Require all denied
</IfModule>
<IfModule !authz_core_module>
	Deny from all
</IfModule>
